int minElement(int* nums, int numsSize) {
    int i;
    for(i=0;i<numsSize;i++){
        int sum=0;
        int temp=nums[i];
        while(temp!=0){
            sum+=temp%10;
           temp =temp/10;
        }
        nums[i]=sum;
    }int min=nums[0];
    for(int k=1;k<numsSize;k++){
        if(nums[k]<min){
            min=nums[k];
        } 
       
    }
     return min;

}
